{
  "name": "@userplane/postbridge",
  "version": "0.6.3",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "private": true,
  "description": "Type-safe bidirectional RPC for postMessage contexts - iframes, workers, and cross-tab communication",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "source": "./src/bridge.ts",
      "import": "./src/bridge.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007",
    "build:worker": "bun build src/bridge-worker.ts --outfile=dist/bridge-worker.bundle.js --format=esm --target=browser && cp dist/bridge-worker.bundle.js src/bridge-worker.js",
    "build": "rm -rf dist && tsc && bun run build:worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "dependencies": {
    "@userplane/console-logger": "*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.3.6",
    "happy-dom": "^20.8.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.5"
  }
}
