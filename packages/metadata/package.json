{
  "name": "@userplane/metadata",
  "description": "Attach custom metadata to Userplane recordings",
  "version": "0.0.1",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "private": false,
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:npm": "tsc && OPTIMIZE_MODE=npm vite build",
    "build:cdn": "tsc && OPTIMIZE_MODE=cdn vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "preview": "vite preview",
    "prepublishOnly": "echo 'Use GitHub Actions to publish. Do not publish locally.' && exit 1"
  },
  "devDependencies": {
    "@userplane/console-logger": "*",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.1.1",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^10.8.0",
    "terser": "^5.46.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.4.0"
  }
}
