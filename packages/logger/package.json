{
  "name": "@userplane/logger",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "rm -rf dist && tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6011",
    "dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6011",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "dependencies": {
    "@userplane/console-logger": "*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/html": "^10.3.6",
    "@storybook/html-vite": "^10.3.6",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.3.6",
    "happy-dom": "^20.8.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.5"
  }
}
