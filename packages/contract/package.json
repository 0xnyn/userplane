{
  "name": "@userplane/contract",
  "type": "module",
  "version": "1.0.0",
  "license": "FSL-1.1-ALv2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "check:mcp-tool-annotations": "bun run scripts/check-mcp-tool-annotations.ts",
    "generate:chatgpt-app-submission": "bun run scripts/generate-mcp-tool-hint-justifications.ts",
    "generate:mcp-tool-justifications": "bun run generate:chatgpt-app-submission"
  },
  "dependencies": {
    "@userplane/logger": "*",
    "@orpc/contract": "^1.14.2",
    "@orpc/zod": "^1.14.2",
    "@userplane/payments": "*",
    "@userplane/pricing": "*",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orpc/openapi": "^1.14.2",
    "@orpc/server": "^1.14.2",
    "@types/node": "^26.1.1",
    "@types/validator": "^13.12.2",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@orpc/server": "^1.14.2"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    }
  }
}
