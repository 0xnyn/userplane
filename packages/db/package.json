{
  "name": "@userplane/db",
  "version": "0.0.1",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:reset": "bun run src/reset.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@userplane/contract": "*",
    "@userplane/common-logger": "*",
    "@userplane/payments": "*",
    "@userplane/pricing": "*",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^26.1.1",
    "@types/pg": "8.23.1",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3"
  }
}
