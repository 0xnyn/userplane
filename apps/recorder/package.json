{
  "name": "recorder",
  "type": "module",
  "version": "0.0.1",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "scripts": {
    "prepare:worker": "bun build ../../packages/postbridge/src/bridge-worker.ts --outfile=public/bridge-worker.js --format=esm --target=browser && cp public/bridge-worker.js ../../packages/postbridge/src/bridge-worker.js",
    "prebuild": "bun run prepare:worker",
    "dev": "bun run prepare:worker && next dev -p 4322",
    "build": "next build",
    "start": "next start -p 4322",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "dev:storybook": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@userplane/client": "*",
    "@userplane/contract": "*",
    "@userplane/shared": "*",
    "@userplane/storage": "*",
    "@userplane/common-logger": "*",
    "@userplane/logger": "*",
    "@userplane/postbridge": "*",
    "@userplane/ui": "*",
    "canvas-confetti": "^1.9.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.5",
    "posthog-js": "^1.372.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@posthog/nextjs-config": "^1.1.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.3.6",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "tw-animate-css": "^1.3.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
