{
  "name": "ramp",
  "version": "0.0.1",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "USERPLANE_SDK_SOURCE=workspace next dev -p 3002",
    "build": "USERPLANE_SDK_SOURCE=npm next build",
    "build:production": "APP_ENV=production USERPLANE_SDK_SOURCE=npm next build",
    "start": "USERPLANE_SDK_SOURCE=npm next start -p 3002",
    "start:production": "APP_ENV=production USERPLANE_SDK_SOURCE=npm next start -p 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx src/lib/db/migrate.ts",
    "db:import-local": "npx tsx src/lib/db/import-local.ts",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "db:reset": "TURSO_ALLOW_SEED_RESET=1 npx tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@intercom/messenger-js-sdk": "^0.0.20",
    "@libsql/client": "^0.18.0",
    "@next/env": "16.3.5",
    "@userplane/common-logger": "*",
    "@userplane/sdk": "0.0.6",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.27.0",
    "next": "16.3.5",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^10.8.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
