{
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orpc/openapi": "^1.14.2",
    "@orpc/server": "^1.14.2",
    "@unkey/api": "^2.3.3",
    "@userplane/auth": "*",
    "@userplane/cache": "*",
    "@userplane/common-logger": "*",
    "@userplane/contract": "*",
    "@userplane/mcp-apps": "*",
    "@userplane/db": "*",
    "@userplane/email": "*",
    "@userplane/payments": "*",
    "@userplane/pricing": "*",
    "@userplane/shared": "*",
    "@userplane/storage": "*",
    "hono": "^4.12.18",
    "inngest": "^4.13.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^6.0.0",
    "posthog-node": "^5.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "slugify": "^1.6.9",
    "stoker": "^2.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@orpc/zod": "^1.14.2",
    "@posthog/cli": "^0.10.0",
    "@types/bun": "^1.3.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^10.8.0"
  },
  "exports": {
    "./routes": "./src/routes/index.ts",
    "./routes/api.router": "./src/routes/api.router.ts"
  },
  "name": "@userplane/api",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "build": "bun build src/index.ts --outdir ./dist --target bun --external inngest --sourcemap=linked && if [ -n \"$POSTHOG_PERSONAL_API_KEY\" ] && [ -n \"$POSTHOG_PROJECT_ID\" ]; then POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap inject --directory ./dist && POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap upload --directory ./dist; else echo 'Skipping source map upload (POSTHOG_PERSONAL_API_KEY or POSTHOG_PROJECT_ID not set)'; fi",
    "dev": "bun run dev:api",
    "dev:api": "env -u DATABASE_URL bun --env-file=.env.development --watch src/index.ts",
    "dev:inngest": "npx inngest-cli@latest dev",
    "dev:hot": "env -u DATABASE_URL bun --env-file=.env.development --hot src/index.ts",
    "start": "bun run dist/index.js",
    "start:production": "bun run --env-file=.env.production dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
