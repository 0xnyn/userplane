{
  "name": "userplane",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=30",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,astro}\"",
    "fix": "bun run lint:fix && bun run format",
    "check:env": "node scripts/check-env-vars.js",
    "check:licenses": "bun run scripts/check-workspace-licenses.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.19",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.2",
    "prism-react-renderer": "^2.4.1"
  },
  "overrides": {
    "@smithy/types": "4.12.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "7.3.5",
    "next": "16.2.9",
    "qs": "6.15.2",
    "postcss": "8.5.15",
    "yaml": "2.9.0",
    "tar": "7.5.16",
    "tmp": "0.2.7",
    "shell-quote": "1.8.4",
    "serialize-javascript": "7.0.6"
  }
}
